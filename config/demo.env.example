# Copy to config/demo.env (make setup does this). Loaded by the Makefile and the workflows.

# Metaflow --environment used for platform runs and deployments.
CANDETECT_METAFLOW_ENV=fast-bakery

# Comma-separated conda channels resolved by @anaconda_base on the platform.
CANDETECT_CONDA_CHANNELS=https://repo.anaconda.com/pkgs/main

# Perimeters. With a single perimeter both stay "default" and @project branches
# (user.<name> for experiments, prod for production) separate the two.
CANDETECT_PERIMETER_EXPERIMENT=default
CANDETECT_PERIMETER_PROD=default

# Promotion gate: runs below this F1 on the held-out test split are refused.
CANDETECT_MIN_F1=0.90
# Recorded as the approver on promotion. Empty means your Metaflow username (platform identity).
CANDETECT_APPROVER=

# Edge image. Base image is a build arg; registry is where build-image.yml pushes.
CANDETECT_BASE_IMAGE=python:3.12-slim-bookworm
CANDETECT_REGISTRY=ghcr.io/philippjfr
# owner/repo, used by promote.py to start build-image.yml with the gh CLI.
CANDETECT_GITHUB_REPO=philippjfr/can-demo

# Domain suffix of app URLs, used for the dashboard's websocket origin (one wildcard level only).
# Derived from the API host api.gtm-01.outerbounds.xyz; confirm it against the URL printed by the first deploy.
CANDETECT_APP_DOMAIN=gtm-01.outerbounds.xyz
